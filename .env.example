# =============================================================
# Odoo Production Environment Variables
# =============================================================
# Copy file nay thanh .env va dien gia tri thuc te:
#   cp .env.example .env
#   nano .env
#
# KHONG BAO GIO commit file .env len Git!
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=thay_mat_khau_database_o_day

# --- Odoo ---
ODOO_ADMIN_PASSWORD=thay_mat_khau_admin_o_day

# --- Updater Daemon ---
UPDATER_TOKEN=thay_token_updater_o_day

# --- Domain & SSL ---
DOMAIN=odoo.example.com
CERTBOT_EMAIL=your_email@gmail.com

# --- Telegram Alerts (tuy chon) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
